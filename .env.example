# Supabase: required for authentication and private recordings.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_public_anon_or_publishable_key

# Required for Android Google Maps; optional Roads matching also uses this key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key
